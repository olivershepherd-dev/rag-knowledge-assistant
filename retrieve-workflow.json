        "jsCode": "const results = $input.all()\n  .map(i => i.json)\n  .filter(j => j && j.document)\n  .map(j => ({\n    source: (j.document.metadata && j.document.metadata.source) || 'Unknown document',\n    content: j.document.pageContent,\n    score: j.score,\n  }));\nif (results.length === 0) {\n  return [{ json: { results: [], message: 'No results found in the knowledge base.' } }];\n}\nreturn [{ json: { results, message: results.length + ' matching chunk(s) found.' } }];"
